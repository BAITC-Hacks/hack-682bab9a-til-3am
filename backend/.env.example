# Copy to backend/.env for local use. Never commit the real API key.
# Any OpenAI-compatible provider works. Recommended: Google Gemini (free tier, good Kazakh).
#   Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Optional; defaults to gemini-2.5-flash for Gemini and llama-3.3-70b-versatile for Groq.
LLM_MODEL=
LLM_TIMEOUT=8

# Alternatives:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   (LLM_MODEL=<model>:free)
#   NVIDIA:     LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Frontend dev origin
CORS_ORIGINS=http://localhost:5173
